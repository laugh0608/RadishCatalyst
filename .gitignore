# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Godot local/editor generated files
*.tmp
*.temp

# Build and export outputs
build/
dist/
exports/
release/

# Logs and local runtime files
*.log
logs/
.godot-check-home/
.godot-check-runs/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor and IDE local settings
.vscode/
.idea/
.vs/
.fleet/
*.suo
*.user
*.userosscache
*.sln.docstates

# Environment and local secrets
.env
.env.*
!.env.example
!.env.*.example
.venv-art/

# Patch / merge leftovers
*.orig
*.rej

# Art pipeline: raw AI batches and third-party packs stay local,
# curated files are processed into client/assets/
assets/art-intake/*
!assets/art-intake/README.md
assets/third-party/*
!assets/third-party/README.md

# Agents
.claude
.claude/
.codex
.codex/
