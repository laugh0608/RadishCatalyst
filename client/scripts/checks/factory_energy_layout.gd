static func rows(stage: String) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var machines: Array = {"C": C_MACHINES, "P": P_MACHINES, "D": D_MACHINES, "D+": D_MACHINES}[stage]
	var belts: Array = {"C": C_BELTS, "P": P_BELTS, "D": D_BELTS, "D+": D_BELTS}[stage]
	for row in machines:
		result.append({"name": row[0], "type": row[1], "x": row[2], "z": row[3], "dir": row[4]})
	for row in belts:
		result.append({"name": "belt_%d_%d" % [row[0], row[1]], "type": "belt", "x": row[0], "z": row[1], "dir": row[2]})
	if stage == "D+":
		result = result.filter(func(row): return not (row.x == -3 and row.z == 14))
		for row in result:
			if row.name == "GF": row.x = -3
		result.append({"name": "SF2", "type": "splitter", "x": -2, "z": 14, "dir": 0})
		result.append({"name": "G2", "type": "cell_generator", "x": -1, "z": 17, "dir": 0})
		for z in range(15, 19):
			result.append({"name": "second_%d" % z, "type": "belt", "x": -2, "z": z, "dir": 0 if z == 18 else 1})
	return result


static func recipes(stage: String) -> Dictionary:
	return {"F": "direct_refining", "C": "carbon_crushing", "R": "basic_catalyst", "E": "cell_assembly"} if stage == "C" else {"F1": "direct_refining", "H1": "direct_sintering", "A1": "construction_assembly"} if stage == "P" else {"F1": "direct_refining", "F2": "direct_refining", "F3": "direct_refining", "H1": "direct_sintering", "H2": "direct_sintering", "A1": "construction_assembly", "A2": "construction_assembly", "C": "carbon_crushing", "R": "basic_catalyst", "E": "cell_assembly"}
